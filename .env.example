# Copy to .env and fill in. Never commit .env.

# Image to run. Leave empty to build from this checkout; for a released build use
# e.g. ghcr.io/<owner>/<repo>:v4.18.0 (see .github/workflows/release.yml).
#LHC_IMAGE=

# Database
LHC_DB_DATABASE=lhc
LHC_DB_USER=lhc
LHC_DB_PASSWORD=change-me-db-password
MARIADB_ROOT_PASSWORD=change-me-root-password

# 64+ random characters, e.g.: openssl rand -hex 40
LHC_SECRET_HASH=change-me-to-a-long-random-string

# First boot creates this administrator (password max 40 characters).
LHC_ADMIN_USERNAME=admin
LHC_ADMIN_PASSWORD=change-me-admin-password
LHC_ADMIN_EMAIL=admin@example.com
# Public host name; with the tls profile Caddy gets a Let's Encrypt certificate for it.
LHC_DOMAIN=chat.example.com
LHC_DEFAULT_DEPARTMENT=Support
LHC_TIMEZONE=UTC

# Web port. Defaults to localhost only: publish it through a TLS reverse proxy.
LHC_HTTP_BIND=127.0.0.1
LHC_HTTP_PORT=8080

# Set to 1 behind a trusted reverse proxy, including the bundled Caddy (tls profile),
# so the visitor IP is taken from X-Forwarded-For.
LHC_PROXY_MODE=0
# Optional: comma separated regular expressions for your host name(s), e.g. ^chat\.example\.com$
# Links the app generates (password reset, SSO redirect URI) then only use a matching Host header.
LHC_TRUSTED_HOST_PATTERNS=

# Optional: /index.php/system/health?token=... returns per-check details.
LHC_HEALTH_TOKEN=

# Optional: enables /index.php/system/metrics (Prometheus). Send as "Authorization: Bearer <token>".
LHC_METRICS_TOKEN=

# Optional: Strict-Transport-Security max-age in seconds once HTTPS works end to end (e.g. 31536000).
LHC_HSTS_MAX_AGE=0

# Apply the bundled database schema on every web container start.
LHC_AUTO_MIGRATE=1

# Optional AI assistant (see AI-ASSISTANT.md). Leave empty to configure it in
# System configuration > AI assistant instead. Values set here win over the settings page.
# Bundled Ollama (docker compose --profile ai): http://ollama:11434/v1
# vLLM on another GPU server:                   http://gpu-server:8000/v1
LHC_AI_BASE_URL=
LHC_AI_MODEL=
# Only when the model server requires one (vLLM --api-key). Or use LHC_AI_API_KEY_FILE.
LHC_AI_API_KEY=
# GPUs given to the bundled Ollama: all, or a number.
LHC_OLLAMA_GPUS=all
