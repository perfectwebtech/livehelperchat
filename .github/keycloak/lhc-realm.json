{
  "realm": "lhc",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "groups": [
    { "name": "support-agents", "path": "/support-agents" },
    { "name": "other-team", "path": "/other-team" }
  ],
  "users": [
    {
      "username": "kc.agent",
      "enabled": true,
      "email": "kc.agent@example.com",
      "emailVerified": true,
      "firstName": "Keycloak",
      "lastName": "Agent",
      "credentials": [ { "type": "password", "value": "KcAgent!234", "temporary": false } ],
      "groups": [ "/support-agents" ],
      "requiredActions": []
    }
  ],
  "clients": [
    {
      "clientId": "lhc-web",
      "name": "Live Helper Chat",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "kc-ci-client-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [ "http://127.0.0.1:8080/*" ],
      "webOrigins": [ "http://127.0.0.1:8080" ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "groups"
          }
        }
      ]
    }
  ]
}
