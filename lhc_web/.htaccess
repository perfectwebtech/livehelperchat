AddType application/wasm .wasm

<Files ~ "\.(gif|jpe?g?|png|bmp|swf|css|js|svg|otf|eot|ttf|woff|woff2|swf|mp3|map|ogg|wasm|wav|pdf|ico|txt)$">
  Header always Set Access-Control-Allow-Origin "*"
  Header always Set Access-Control-Allow-Methods: "GET, POST, OPTIONS, PUT, DELETE"
  Header always Set Access-Control-Allow-Headers: "Origin, X-Requested-With, Content-Type, Accept, API-Key, Authorization"
</Files>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Pass the Authorization header to PHP so REST API keys keep working
    RewriteCond %{HTTP:Authorization} ^(.*)
    RewriteRule .* - [e=HTTP_AUTHORIZATION:%1]

    # Static assets (design/*, extension/<ext>/design/*, cache/compiledtemplates/*.css|js and uploads in var/*) are served from disk
    RewriteRule \.(gif|jpe?g|png|webp|bmp|css|js|svg|otf|eot|ttf|woff|woff2|mp3|map|ogg|wasm|wav|pdf|ico|txt)$ - [L]

    # Private folders are never reachable directly (logs in cache/, settings, sources)
    RewriteRule ^(albums|bin|var|lib|cache|doc|settings|pos|modules|translations|cli|tests|ezcomponents|node_modules)(/|$) - [F,L]
</IfModule>
